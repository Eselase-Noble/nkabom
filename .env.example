# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"

# AI scam analysis. Set EITHER (or both) — Claude is preferred, OpenAI is the
# fallback, and if neither is set a built-in heuristic is used.
#   Claude: https://console.anthropic.com   OpenAI: https://platform.openai.com
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional model overrides.
# ANTHROPIC_MODEL="claude-opus-4-8"
# OPENAI_MODEL="gpt-4o-mini"

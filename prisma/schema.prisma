// Nkabom data model (MVP).
// SQLite for local dev; swap the datasource provider to "postgresql" for prod.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A seller/merchant whose trustworthiness the community can look up.
/// Identified primarily by their MoMo / phone number — the way deals happen in Ghana.
model Seller {
  id           String   @id @default(cuid())
  name         String
  businessName String?
  phone        String   @unique // MoMo / contact number, normalized
  region       String? // e.g. "Greater Accra"
  verified     Boolean  @default(false)
  trustScore   Int      @default(50) // 0-100, derived from reports
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports Report[]
}

/// A community report about a seller (positive or negative) feeding the trust score.
model Report {
  id        String   @id @default(cuid())
  seller    Seller   @relation(fields: [sellerId], references: [id])
  sellerId  String
  kind      String // "scam" | "complaint" | "praise"
  note      String?
  createdAt DateTime @default(now())
}

/// A saved result of the AI scam checker. These rows ARE the training signal:
/// confirmed scams feed retrieval (RAG) and community number reports over time.
model ScamCheck {
  id        String   @id @default(cuid())
  content   String // the message/offer the user pasted
  channel   String // "sms" | "whatsapp" | "call" | "social" | "other"
  language  String // requested explanation language, e.g. "en", "twi"
  riskLevel String // "safe" | "caution" | "danger"
  riskScore Int // 0-100
  verdict   String // short plain-language verdict
  signals   String // JSON array of detected red-flag strings
  feedback  String? // user ground truth: "scam" | "safe" | null
  learned   Boolean  @default(false) // whether we've mined this row into community memory
  createdAt DateTime @default(now())

  @@index([riskLevel, createdAt])
  @@index([feedback])
}

/// Online-learned signal weights. Each term accumulates how often it appears in
/// scam vs. safe messages; the heuristic reads these to adapt over time. This is
/// the "model" that updates incrementally with every labelled request.
model LearnedSignal {
  id        String   @id @default(cuid())
  term      String   @unique // normalized keyword or number token
  scamCount Int      @default(0)
  safeCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([scamCount])
}
